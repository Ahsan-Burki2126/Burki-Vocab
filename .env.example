# Copy to .env.local for local development (never commit .env.local).
# On Vercel add the same two variables under Project → Settings → Environment Variables.
# Supabase: Project Settings → API (or "Connect") → Project URL and publishable/anon key.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
